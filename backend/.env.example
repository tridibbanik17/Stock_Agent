# Supabase → Project Settings → Data API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Server-side only (sb_secret_... or legacy service_role JWT)
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Optional client/publishable key (sb_publishable_... or legacy anon JWT)
# Not used by the FastAPI upsert path — kept for future browser-safe reads.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Resend (https://resend.com) — leave blank to dry-run / log reports in cron
RESEND_API_KEY=re_secret_xxxxxxxx
REPORT_FROM_EMAIL=Stock Agent Chrome Extension <onboarding@resend.dev>

# Public base URL used in email unsubscribe links (no trailing slash)
PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Hybrid B dispatcher: POST /api/internal/dispatch-due (required in production)
# Generate a long random string; GitHub Actions / Cloud Scheduler send it as
# header X-Dispatch-Secret. Leave blank locally to disable the HTTP endpoint.
DISPATCH_SECRET=change_me_to_a_long_random_string

# Early send window (minutes before preferred time) and overdue catch-up
DISPATCH_EARLY_MINUTES=10
DISPATCH_LATE_MINUTES=120

# Parallel email workers per cron tick (1–32). Default 8.
CRON_DISPATCH_WORKERS=8

# yfinance quote retries when price/metrics come back empty
QUOTE_FETCH_RETRIES=4
QUOTE_FETCH_BACKOFF_SECONDS=1.0

# Public API hardening (per client IP, in-process sliding window)
RATE_LIMIT_SUBSCRIBE_PER_MIN=10
RATE_LIMIT_SNAPSHOT_PER_MIN=30
RATE_LIMIT_UNSUBSCRIBE_PER_MIN=30
RATE_LIMIT_RECOVER_PER_MIN=5
RATE_LIMIT_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=65536
# Set true on Heroku / behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# On Heroku, also set PUBLIC_API_BASE_URL to your HTTPS service URL, e.g.
# PUBLIC_API_BASE_URL=https://stock-agent-api-2aee861fcc19.herokuapp.com

# News (Yahoo RSS works in CI; set SKIP to disable; ALLOW_GOOGLENEWS for old path)
# STOCK_AGENT_SKIP_NEWS=false
# STOCK_AGENT_ALLOW_GOOGLENEWS=false
# NEWS_CACHE_TTL_SECONDS=21600
# NEWS_CACHE_DIR=

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
