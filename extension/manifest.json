{
  "manifest_version": 3,
  "name": "StockAgent - Live stock grades, rule-based scoring & auto email reports",
  "version": "0.1.107",
  "description": "A privacy-first stock dashboard that grades your watchlist using deterministic rules — no AI. Optional AI explanations via your own Gemini key.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Stock Agent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "side_panel": {
    "default_path": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S",
        "mac": "MacCtrl+Shift+S",
        "chromeos": "Alt+S",
        "linux": "Alt+S"
      },
      "description": "Open Stock Agent side panel"
    }
  },
  "host_permissions": [
    "https://api.stockagent.app/*",
    "https://*.onrender.com/*",
    "https://*.herokuapp.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
